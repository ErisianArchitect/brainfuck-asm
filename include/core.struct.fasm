
;---
; core.struct
;---

label core.struct
;--- Types are just built in primitive types like i64, i32, etc.
label core.struct.types
label core.struct.primitives
label core.struct.primitive_exists
;--- Directives are for macros that can be called from inside of a struct definition
label core.struct.directives
;--- To store flags for directives that exist.
;--- Example for directive_exists:
; core.struct.directive_exists.foobar = 1
; if definite core.struct.directive_exists.foobar
;    display "foobar", 10
; end if
label core.struct.directive_exists

macro core.struct.make_primitive t_name*, t_size*, t_align*
    core.struct.primitive_exists.#t_name = 1
    namespace core.primitives.#t_name
        size = t_size
        alignment = t_align
    end namespace
end macro

macro core.struct.primitive input&
    match t_name=( t_size=, t_alignment =), input
        core.struct.make_primitive t_name, t_size, t_align
    else match t_name=(t_size_align), input
        core.struct.make_primitive t_name, t_size_align, t_size_align
    else
        err "Expected something like i32(size, align)".
    end match
end macro

core.struct.primitive bool(1)
core.struct.primitive i8(1)
core.struct.primitive i16(2)
core.struct.primitive i32(4)
core.struct.primitive i64(8)
core.struct.primitive i128(16)
core.struct.primitive i256(32)
core.struct.primitive i512(64)
core.struct.primitive f16(2)
core.struct.primitive f32(4)
core.struct.primitive f64(8)

purge core.struct.primitive

calminstruction struct.directive input&
    match macro_name:name(args), input, :
    jyes with_parens
    match macro_name:name=(=), input, :
    jyes with_parens_no_args
    match macro_name:name, input, :
    jyes only_name
    stringify input
    compute err_text, "Invalid syntax" bappend input
    err err_text
with_parens:
    arrange output, =core.=struct.=directive_exists.macro_name == =1
    assemble output
    arrange output, =macro =core.=struct.=directives.macro_name =input&
    assemble output
    arrange output,     =match ==( =args ==)=, =input
    assemble output
    arrange output,         =core.=struct.=directives.macro_name.=real =args
    assemble output
    arrange output,     =else
    assemble output
    arrange output,         =err "Expected parentheses."
    assemble output
    arrange output,     =end =match
    assemble output
    arrange output, =end =macro
    assemble output
    arrange output, =macro =core.=struct.=directives.macro_name.=real args
    assemble output
    exit
with_parens_no_args:
    arrange output, =core.=struct.=directive_exists.macro_name == =1
    assemble output
    arrange output, =macro =core.=struct.=directives.macro_name =input&
    assemble output
    arrange output,     =match ==( ==)=, =input
    assemble output
    arrange output,         =core.=struct.=directives.macro_name.=real
    assemble output
    arrange output,     =else
    assemble output
    arrange output,         =display ="Unexpected input: " =, =`=input=, =10
    assemble output
    arrange output,         =err "Expected parentheses."
    assemble output
    arrange output,     =end =match
    assemble output
    arrange output, =end =macro
    assemble output
    arrange output, =macro =core.=struct.=directives.macro_name.=real
    assemble output
    exit
only_name:
    arrange output, =core.=struct.=directive_exists.macro_name == =1
    assemble output
    arrange output, =macro =core.=struct.=directives.macro_name
    assemble output
    exit
end calminstruction

macro end?.struct.directive!
    esc end macro
end macro

struct.directive foo
    display "foo directive", 10
end struct.directive

macro struct name*
    macro ?! line&
        match =end =struct, line
            purge ?
            ;-- Do other stuff...
        else
            ;--- Expect line such as:
            ; ```
            ; name type
            ; or
            ; name type[array_len]
            ; ```
            ; hmm... I'm not exactly sure what would be the best
            ; way to allocate virtual space for an array. I suppose
            ; by adding a multiple of the size.
            ;
            ; Essentially, what needs to happen is there needs to be a registry of "types",
            ; and that registry needs to contain the primitive types as well as the types
            ; created by the `struct` and `union` macros.
        end match
    end macro
end macro

if ~ definite core
    label core
end if
label core.struct.enum_builder
core.struct.enum_builder.index = 0

macro enum name*
    core.struct.enum_builder.index = 0
    esc namespace name
    macro ?! line&
        match =end =enum, line
            purge ?
            esc end namespace
        else match variant_name == value, line
            variant_name = value
            core.struct.enum_builder.index = value + 1
        else match variant_name, line
            variant_name = core.struct.enum_builder.index
            core.struct.enum_builder.index = core.struct.enum_builder.index + 1
        else
            err "Invalid input."
        end match
    end macro
end macro

comment -->
    ;---
    ; It should be noted that `struct` and `union` are being designed for stack
    ; and in-memory usage, but not necessarily for static memory.
    union foo_and_bar ;-- size:8, align:8
        foo: i32 ;-- 0..4
        bar: i64 ;-- 0..8
    end union

    struct range
        start: i32
        end:   i32
    end struct

    struct foobar
        foo:    i32          ;-- 0..4
        bar:    i64          ;-- 8..16 greatest alignment (8)
        baz:    i8[2]        ;-- 16..18
        foobar: foo_and_bar  ;-- 24..32
        range:  range        ;-- 32..40
    end struct
    foobar.foobar.foo ;-- 24
    foobar.foobar.bar ;-- 24
    foobar.baz        ;-- 16
    foobar.foo.st.put eax
    foobar.range.start.st.put rcx
-->
