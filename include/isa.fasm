include './fasmg/packages/x86/include/cpu/x64.inc'
include './fasmg/packages/utility/align.inc'
use64


label isa.directives
label isa.has_directive

;--------
; # FORMAT SPECIFICATION
; === VERSION[0.1.0]
; ### Footer
; 32-byte footer at the end of the file.
; The footer contains the following information:
; ```
; #[repr(C, align(32)]
; struct Footer {
;     instruction_start: u32,      (00..04)
;     instruction_end  : u32,      (04..08)
;     chunks_start     : u32,      (08..12)
;     chunks_end       : u32       (12..16)
;     chunk_count      : u32,      (16..20)
;     _reserved        : [u32; 3], (20..32)
; }
; ```
; The section where the instructions are stored starts
; at  `instruction_start`, and ends at `instruction_end`.
; The section where the chunks are stored starts
; at `chunks_start` and ends at `chunks_end`.
; The chunk_count is provided for your convenience.
; 12 bytes are reserved for alignment, padding, and
; future use.
;
; ### Chunks
; Chunks store the source code as text as well as
; offset information where the machine code is stored.
; ```
; struct Chunk {
;    source_len: u16,
;    source: str[source_len],
;    // Null byte for compatibility with C-strings.
;    _null_end: 0u8,
;    code_start: u32,
;    code_end: u32,
; }
; ```
;--------

macro emit_footer inst_start*, inst_end*, chunks_start*, chunks_end*, chunk_count*
    align 32
    dd inst_start
    dd inst_end
    dd chunks_start
    dd chunks_end
    dd chunk_count
    dd 0xDEADBEEF
    dd 0xDEADBEEF
    dd 0xDEADBEEF
end macro

macro push_code_line line&
    isa.code_lines equ line
end macro

macro push_source_line line&
    isa.source_lines equ line
end macro

macro emit_chunk code_start*, code_end*, source&
    local source_len
    virtual at 0
        db `source
        source_len = $
    end virtual
    dw source_len
    db `source
    db 0
    dd code_start
    dd code_end
end macro

macro isa
    macro ?! line&
        match =end =isa, line
            purge ?
            isa.code_start = $
            irpv code_line, isa.code_lines
                code_line
            end irpv
            isa.code_end = $
            isa.chunks_start = $
            isa.chunk_count = 0
            isa.inst_offset = isa.code_start
            irpv source_line, isa.source_lines
                match label_name =:, source_line
                    emit_chunk isa.inst_offset, isa.inst_offset, source_line
                else
                    virtual at isa.inst_offset
                        isa.inst_start = $
                        source_line
                        isa.inst_end = $
                        isa.inst_offset = $
                    end virtual
                    emit_chunk isa.inst_start, isa.inst_end, source_line
                end match
                isa.chunk_count = isa.chunk_count + 1
            end irpv
            isa.chunks_end = $
            emit_footer isa.code_start, isa.code_end, isa.chunks_start, isa.chunks_end, isa.chunk_count
        else match , line
        else match inst rest, line
            if definite isa.has_directive.#inst
                line
            else
                push_code_line line
                push_source_line line
            end if
        else match inst, line
            if definite isa.has_directive.#inst
                line
            else
                push_code_line line
                push_source_line line
            end if
        else
            push_code_line line
            push_source_line line
        end match
    end macro
end macro
