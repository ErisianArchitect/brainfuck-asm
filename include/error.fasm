import from syscalls

struc (name) error exit_code*, content*&
    name:
        .start:
        db 0x1b, "[38;2;255;0;0mError", 0x1b, "[39m: ", content, 10
        .end:
        .len = .end - .start
        db 0  ;--- Null terminator.

    macro name.print
        push rdi
        push rsi
        push rdx
        push rax
        mov rdi, 2
        mov rsi, name
        mov rdx, name.len
        sys.write
        pop rax
        pop rdx
        pop rsi
        pop rdi
    end macro

    macro name.exit
        mov rdi, 2
        mov rsi, name
        mov rdx, name.len
        sys.write
        mov rdi, exit_code
        sys.exit
    end macro
end struc


